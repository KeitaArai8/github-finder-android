<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 29+: ウィンドウ背景などをシステムのライト/ダークに追従させる（ダーク時に起動直後だけ白くなるのを防ぐ）。
      com.google.android.material は依存に無く追加もしないため、Theme.Material3.DayNight.NoActionBar ではなく
      framework の DayNight を使う（DeviceDefault.DayNight.NoActionBar は存在しないので ActionBar/タイトルは item で消す）。
    -->
    <style name="Theme.GitHubFinderAndroid" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
