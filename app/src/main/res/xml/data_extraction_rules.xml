<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ のクラウドバックアップ・デバイス間転送から Room DB を除外する設定。
  backup_rules.xml と同じ除外範囲を dataExtractionRules 側にも定義し、
  新旧どちらの OS でもお気に入りDBが転送対象にならないようにする。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="github_finder.db" />
        <exclude domain="database" path="github_finder.db-shm" />
        <exclude domain="database" path="github_finder.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="github_finder.db" />
        <exclude domain="database" path="github_finder.db-shm" />
        <exclude domain="database" path="github_finder.db-wal" />
    </device-transfer>
</data-extraction-rules>
